{
    "name": "yeswiki/extension-oidcserver",
    "description": "Turns a YesWiki into an OpenID Connect provider",
    "type": "yeswiki-extension",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "league/oauth2-server": "^9.4",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "platform-check": true,
        "sort-packages": true
    }
}
